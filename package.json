{
  "name": "birframework",
  "version": "0.5.28",
  "description": "Next-Gen Full-Stack Framework with Laravel DX and Modern TypeScript Type-Safety",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./router": {
      "import": "./dist/router/index.js",
      "types": "./dist/router/index.d.ts"
    },
    "./container": {
      "import": "./dist/container/index.js",
      "types": "./dist/container/index.d.ts"
    },
    "./http": {
      "import": "./dist/http/index.js",
      "types": "./dist/http/index.d.ts"
    },
    "./jsx": {
      "import": "./dist/jsx/index.js",
      "types": "./dist/jsx/index.d.ts"
    }
  },
  "bin": {
    "bir": "./bin/bir.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "BIRFRAMEWORK_RULES.md",
    ".cursorrules"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/**/*.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "bump": "node scripts/bump.js",
    "bir": "tsx src/cli/index.ts",
    "dev:example": "tsx example/app.ts",
    "test:package": "node scripts/smoke-package.mjs",
    "test:databases": "node scripts/smoke-databases.mjs"
  },
  "keywords": [
    "framework",
    "laravel",
    "typescript",
    "fullstack",
    "type-safe"
  ],
  "license": "MIT",
  "author": "Ferdi Sahin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferdisahin/BirFramework.git"
  },
  "bugs": {
    "url": "https://github.com/ferdisahin/BirFramework/issues"
  },
  "homepage": "https://github.com/ferdisahin/BirFramework#readme",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "preact": "^10.25.0",
    "preact-render-to-string": "^6.5.11"
  }
}
